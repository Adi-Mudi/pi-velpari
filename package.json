{
  "name": "@adi-mudi/pi-velpari",
  "version": "1.3.0-dev.1",
  "description": "Stage-gated pre-production orchestration for Pi — Brainstorm → PRD → RTM → Feasibility → Design → Pseudocode → Test Plan, with 4-scout visible subagents per stage and structured doctor audit.",
  "type": "module",
  "main": "./pi-extension/src/index.ts",
  "license": "MIT",
  "author": {
    "name": "Adi-Mudi",
    "url": "https://github.com/Adi-Mudi"
  },
  "homepage": "https://github.com/Adi-Mudi/pi-velpari#readme",
  "bugs": "https://github.com/Adi-Mudi/pi-velpari/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adi-Mudi/pi-velpari.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pi": ">=0.74.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test $(find dist/pi-extension/test -name '*.test.js' -not -path '*/e2e/*' -not -path '*/in-process/*')",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-reporter=spec $(find dist/pi-extension/test -name '*.test.js' -not -path '*/e2e/*' -not -path '*/in-process/*')",
    "test:e2e": "npm run build && RUN_E2E=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:tier2": "RUN_E2E=1 RUN_LLM_E2E=1 node --test --test-force-exit --test-timeout=300000 dist/pi-extension/test/e2e/*.test.js",
    "test:l3": "RUN_L3_E2E=1 node --test --test-force-exit --test-timeout=60000 dist/pi-extension/test/in-process/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint pi-extension/src/",
    "format": "biome format --write pi-extension/src/",
    "format:check": "biome format pi-extension/src/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bundledDependencies": [],
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^20.0.0",
    "pi-coding-agent-test": "^0.1.1",
    "typebox": "^1.3.27",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "orchestration",
    "prd",
    "rtm"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bundleDependencies": []
}
