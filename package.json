{
  "name": "@Adi-Mudi/pi-velpari",
  "version": "1.0.0",
  "description": "Stage-gated pre-production orchestration for Pi",
  "type": "module",
  "main": "./pi-extension/src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-force-exit dist/pi-extension/test/*.test.js",
    "test:e2e": "npm run build && RUN_E2E=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:tier2": "RUN_E2E=1 RUN_LLM_E2E=1 node --test --test-force-exit --test-timeout=300000 dist/pi-extension/test/e2e/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-interactive-subagents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^20.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "orchestration",
    "prd",
    "rtm"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./pi-extension/src/index.ts"
    ]
  }
}
